# Copy to .env.local for local dev. Never commit real values.
# Used ONLY by scripts/snapshot.ts, which copies the website content out of the database before
# every dev start, build and typecheck. The deployed website never connects to a database.
# Local dev value (docker compose up -d, then pnpm db:migrate && pnpm db:seed):
#   postgresql://salon:salon_dev_only@localhost:5433/salon
DATABASE_URL=postgresql://salon:salon_dev_only@localhost:5433/salon
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
