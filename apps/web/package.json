    "@types/node": "22.15.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
