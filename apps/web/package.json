{
  "name": "@salon/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "predev": "pnpm snapshot",
    "snapshot": "tsx scripts/snapshot.ts",
    "prebuild": "pnpm snapshot",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "pnpm snapshot && tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start --port 3000",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@opennextjs/cloudflare": "1.20.15",
    "@salon/booking": "workspace:*",
    "@salon/config": "workspace:*",
    "@salon/db": "workspace:*",
    "@salon/security": "workspace:*",
    "@salon/ui": "workspace:*",
    "clsx": "2.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.0",
    "@types/pg": "8.15.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "dotenv": "17.2.0",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.3",
    "pg": "8.16.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
