# Local dev (docker compose up -d). Never commit real values.
DATABASE_URL=postgresql://salon:salon_dev_only@localhost:5433/salon
# Neon: DATABASE_URL = pooled string (runtime), DIRECT_URL = direct string (migrations only)
DIRECT_URL=postgresql://salon:salon_dev_only@localhost:5433/salon

# Seed: OWNER account (never hard-coded)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
