# Copy to .env.local for local dev. Never commit real values.
#
# Database (Neon pooled string in production; local value from `docker compose up -d`):
DATABASE_URL=postgresql://salon:salon_dev_only@localhost:5433/salon
# Local development and CI use plain pg. On Cloudflare leave this unset (it defaults to the Neon driver).
DB_DRIVER=pg

# Auth.js. AUTH_SECRET signs the session cookie: generate one with `openssl rand -base64 32`, never
# reuse it across environments, and keep it a Worker secret in production. AUTH_URL is the public
# address of the staff app's Auth.js endpoints: your domain + /admin/api/auth. https makes the session cookie Secure.
AUTH_SECRET=replace-with-a-long-random-value
AUTH_URL=http://localhost:3001/admin/api/auth

# Cloudflare Turnstile on the sign-in form. These are Cloudflare's published DUMMY keys (they always
# pass): for development and tests only. In production use the real site key at build time and the
# real secret as a Worker secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
