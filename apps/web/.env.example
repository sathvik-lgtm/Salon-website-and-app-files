# Copy to .env.local for local dev and builds. Never commit real values.
#
# Database. Used by scripts/snapshot.ts (website content, copied at build time) AND by the booking API
# at runtime. Local value (docker compose up -d, then pnpm db:migrate && pnpm db:seed):
DATABASE_URL=postgresql://salon:salon_dev_only@localhost:5433/salon
# Local development and CI use plain pg. On Cloudflare leave this unset (it defaults to the Neon driver).
DB_DRIVER=pg

# Cloudflare Turnstile. These are Cloudflare's published DUMMY keys: they always pass, so they are for
# development and tests only. In production use the real site key at build time (it is inlined into the
# page) and the real secret as a Worker secret. A real secret rejects the dummy token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
