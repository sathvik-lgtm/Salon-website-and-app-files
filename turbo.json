{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "env": ["NEXT_PUBLIC_TURNSTILE_SITE_KEY", "NEXT_PUBLIC_CF_BEACON_TOKEN"], "passThroughEnv": ["DATABASE_URL"], "outputs": [".next/**", ".open-next/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true, "passThroughEnv": ["DATABASE_URL"] },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"], "passThroughEnv": ["DATABASE_URL"] },
    "test": { "passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL"] }
  }
}
